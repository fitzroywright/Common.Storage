<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Common.Storage</RootNamespace>
    <PackageId>Common.Storage</PackageId>
    <Description>Shared local-first file storage contracts and filesystem provider.</Description>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildProjectDirectory)/..</CommonRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(CommonRoot)/Common.Diagnostics/Common.Diagnostics.csproj" Condition="Exists('$(CommonRoot)/Common.Diagnostics/Common.Diagnostics.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Common.Storage.Tests/**/*.cs" />
    <EmbeddedResource Remove="Common.Storage.Tests/**" />
    <None Remove="Common.Storage.Tests/**" />
  </ItemGroup>
</Project>
